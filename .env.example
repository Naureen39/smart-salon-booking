# App
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# `docker compose up` overrides this to the `postgres` service hostname for
# the backend/celery containers directly in docker-compose.yml — this value
# only matters when running the backend outside Docker (localhost, with
# Postgres reached via its published port — 5433, not 5432, since the
# compose file avoids the default port to reduce collisions with other
# projects' Postgres containers).
DATABASE_URL=postgresql+asyncpg://glowdesk:glowdesk@localhost:5433/glowdesk

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM providers (free tiers)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-flash-latest
GEMINI_MODEL_LITE=gemini-flash-lite-latest
GROQ_DAILY_REQUEST_LIMIT=1000
GEMINI_DAILY_REQUEST_LIMIT=1500

# Voice
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
# pyttsx3 (offline OS speech) is the real, working default — see
# docs/KNOWN_LIMITATIONS.md for what switching to openvoice_v2 requires.
TTS_ENGINE=pyttsx3
TTS_REFERENCE_VOICE_PATH=/app/assets/brand_voice_sample.wav

# RAG
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_SIMILARITY_THRESHOLD=0.65

# Email (reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Rate limiting
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_VOICE_PER_MINUTE=5
